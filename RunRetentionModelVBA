Sub RunRetentionModel()

Dim wsData As Worksheet, wsEngine As Worksheet, wsDashboard As Worksheet

Set wsData = ThisWorkbook.Sheets("PolicyRetention")
Set wsEngine = ThisWorkbook.Sheets("AnalysisEngine")
Set wsDashboard = ThisWorkbook.Sheets("DashboardSummary")

Dim lastRow As Long
lastRow = wsData.Cells(wsData.Rows.Count, "A").End(xlUp).Row

Dim totalRenewedPremium As Double
Dim totalChurnedPremium As Double
Dim renewedCount As Long
Dim churnedCount As Long
Dim telematicsRenewedCount As Long
Dim rateIncreaseArr() As Double
ReDim rateIncreaseArr(1 To lastRow)

Dim rateIncreaseAvg As Double
Dim rateIncreaseSum As Double
Dim rateIncreaseCount As Long

Dim i As Long
Dim renewedIndex As Long

Dim portfolioRetentionRate As Double
Dim premiumChurnExposure As Double
Dim telematicsRetentionImpact As Double

rateIncreaseAvg = 0
renewedIndex = 0

wsEngine.Cells.Clear
wsDashboard.Cells.Clear

wsEngine.Range("A1:F1").Value = Array("Policy ID", "Tenure (Years)", "Rate Increase", "Telematics", "Premium", "Status")


For i = 2 To lastRow
    If wsData.Cells(i, 6).Value = "Renewed" Then
        renewedIndex = renewedIndex + 1
        rateIncreaseArr(renewedIndex) = wsData.Cells(i, 3)
        renewedCount = renewedCount + 1
        totalRenewedPremium = totalRenewedPremium + wsData.Cells(i, 5).Value
        If wsData.Cells(i, 4).Value = "Yes" Then
            telematicsRenewedCount = telematicsRenewedCount + 1
        End If
    ElseIf wsData.Cells(i, 6).Value = "Churned" Then
        churnedCount = churnedCount + 1
        totalChurnedPremium = totalChurnedPremium + wsData.Cells(i, 5).Value
    End If
    
    wsEngine.Cells(i, 1).Value = wsData.Cells(i, 1).Value
    wsEngine.Cells(i, 2).Value = wsData.Cells(i, 2).Value
    wsEngine.Cells(i, 3).Value = wsData.Cells(i, 3).Value
    wsEngine.Cells(i, 4).Value = wsData.Cells(i, 4).Value
    wsEngine.Cells(i, 5).Value = wsData.Cells(i, 5).Value
    wsEngine.Cells(i, 6).Value = wsData.Cells(i, 6).Value
Next i

ReDim Preserve rateIncreaseArr(1 To renewedIndex)

rateIncreaseSum = Application.WorksheetFunction.Sum(rateIncreaseArr)
rateIncreaseAvg = rateIncreaseSum / renewedIndex


If (renewedCount + churnedCount) > 0 Then
    portfolioRetentionRate = renewedCount / (renewedCount + churnedCount)
Else
    portfolioRetentionRate = 0
End If

If renewedCount > 0 Then
    telematicsRetentionImpact = telematicsRenewedCount / (renewedCount)
Else
    telematicsRetentionImpact = 0
End If

If (totalChurnedPremium + totalRenewedPremium) > 0 Then
    premiumChurnExposure = totalChurnedPremium / (totalChurnedPremium + totalRenewedPremium)
Else
    premiumChurnExposure = 0
End If

With wsDashboard
    .Cells(1, 1).Value = "Retention Elasticity"
    .Cells(1, 1).Font.Bold = True
    
    .Cells(4, 1).Value = "Total Renewed Count"
    .Cells(4, 2).Value = renewedCount
    
    .Cells(5, 1).Value = "Total Churned Count"
    .Cells(5, 2).Value = churnedCount
    
    .Cells(7, 1).Value = "Portfolio Retention Rate"
    .Cells(7, 2).Value = portfolioRetentionRate
    
    .Cells(8, 1).Value = "Premium Churn Exposure"
    .Cells(8, 2).Value = premiumChurnExposure
    
    .Cells(9, 1).Value = "Telematics Retention Impact"
    .Cells(9, 2).Value = telematicsRetentionImpact
    
    .Cells(10, 1).Value = "Optimal Average Rate Increase Threshold"
    .Cells(10, 2).Value = rateIncreaseAvg

    .Range("B7").NumberFormat = "0.00%"
    .Range("B8").NumberFormat = "0.00%"
    .Range("B9").NumberFormat = "0.00%"
    .Range("B10").NumberFormat = "0.00%"
End With

MsgBox "Retention analysis run successfully!", vbInformation

End Sub
